{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 3,
  "settings": {
    "appearanceTools": true,
    "useRootPaddingAwareAlignments": true,
    "layout": {
      "contentSize": "760px",
      "wideSize": "1200px"
    },
    "color": {
      "defaultPalette": false,
      "defaultGradients": false,
      "custom": true,
      "palette": [
        {
          "slug": "primary",
          "color": "#81007F",
          "name": "Primary Blue"
        },
        {
          "slug": "primary-dark",
          "color": "#5C005A",
          "name": "Primary Dark"
        },
        {
          "slug": "primary-tint",
          "color": "#F3E6F2",
          "name": "Primary Tint"
        },
        {
          "slug": "secondary",
          "color": "#000000",
          "name": "Secondary Ink"
        },
        {
          "slug": "accent",
          "color": "#81007F",
          "name": "Accent Amber"
        },
        {
          "slug": "accent-soft",
          "color": "#F3E6F2",
          "name": "Accent Soft"
        },
        {
          "slug": "white",
          "color": "#FFFFFF",
          "name": "White"
        },
        {
          "slug": "surface",
          "color": "#F7F9FC",
          "name": "Surface"
        },
        {
          "slug": "line",
          "color": "#E4E9F0",
          "name": "Hairline"
        },
        {
          "slug": "muted",
          "color": "#5B6472",
          "name": "Muted Text"
        }
      ],
      "gradients": [
        {
          "slug": "hero",
          "gradient": "linear-gradient(135deg, #0A4FA3 0%, #083C7C 60%, #062E60 100%)",
          "name": "Hero Blue"
        },
        {
          "slug": "glass",
          "gradient": "linear-gradient(135deg, rgba(255,255,255,0.14) 0%, rgba(255,255,255,0.04) 100%)",
          "name": "Glass"
        }
      ]
    },
    "typography": {
      "fluid": true,
      "defaultFontSizes": false,
      "customFontSize": true,
      "fontFamilies": [
        {
          "fontFamily": "'Manrope', system-ui, sans-serif",
          "slug": "heading",
          "name": "Manrope",
          "fontFace": [
            {
              "fontFamily": "Manrope",
              "fontWeight": "400 800",
              "fontStyle": "normal",
              "fontStretch": "normal",
              "src": [
                "file:./assets/fonts/manrope-var.woff2"
              ],
              "fontDisplay": "swap"
            }
          ]
        },
        {
          "fontFamily": "'Inter', system-ui, sans-serif",
          "slug": "body",
          "name": "Inter",
          "fontFace": [
            {
              "fontFamily": "Inter",
              "fontWeight": "400 700",
              "fontStyle": "normal",
              "fontStretch": "normal",
              "src": [
                "file:./assets/fonts/inter-var.woff2"
              ],
              "fontDisplay": "swap"
            }
          ]
        }
      ],
      "fontSizes": [
        {
          "slug": "xs",
          "size": "0.8125rem",
          "name": "XS"
        },
        {
          "slug": "small",
          "size": "0.9375rem",
          "name": "Small"
        },
        {
          "slug": "base",
          "size": "1.0625rem",
          "name": "Base"
        },
        {
          "slug": "medium",
          "size": "1.25rem",
          "name": "Medium"
        },
        {
          "slug": "large",
          "size": "clamp(1.5rem, 1.2rem + 1.2vw, 2rem)",
          "name": "Large"
        },
        {
          "slug": "x-large",
          "size": "clamp(2rem, 1.5rem + 2.4vw, 3rem)",
          "name": "XL"
        },
        {
          "slug": "xx-large",
          "size": "clamp(2.6rem, 1.8rem + 3.6vw, 4.25rem)",
          "name": "Display"
        }
      ]
    },
    "spacing": {
      "units": [
        "px",
        "em",
        "rem",
        "vh",
        "vw",
        "%"
      ],
      "spacingScale": {
        "steps": 0
      },
      "spacingSizes": [
        {
          "slug": "20",
          "size": "0.5rem",
          "name": "1"
        },
        {
          "slug": "30",
          "size": "1rem",
          "name": "2"
        },
        {
          "slug": "40",
          "size": "1.5rem",
          "name": "3"
        },
        {
          "slug": "50",
          "size": "2.5rem",
          "name": "4"
        },
        {
          "slug": "60",
          "size": "4rem",
          "name": "5"
        },
        {
          "slug": "70",
          "size": "6rem",
          "name": "6"
        },
        {
          "slug": "80",
          "size": "8rem",
          "name": "7"
        }
      ]
    },
    "border": {
      "radius": true,
      "color": true,
      "style": true,
      "width": true
    }
  },
  "styles": {
    "color": {
      "background": "var(--wp--preset--color--white)",
      "text": "var(--wp--preset--color--secondary)"
    },
    "typography": {
      "fontFamily": "var(--wp--preset--font-family--body)",
      "fontSize": "var(--wp--preset--font-size--base)",
      "lineHeight": "1.65"
    },
    "elements": {
      "heading": {
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--heading)",
          "fontWeight": "700",
          "lineHeight": "1.15",
          "letterSpacing": "-0.02em"
        }
      },
      "h1": {
        "typography": {
          "fontSize": "var(--wp--preset--font-size--xx-large)"
        }
      },
      "h2": {
        "typography": {
          "fontSize": "var(--wp--preset--font-size--x-large)"
        }
      },
      "h3": {
        "typography": {
          "fontSize": "var(--wp--preset--font-size--large)"
        }
      },
      "link": {
        "color": {
          "text": "var(--wp--preset--color--primary)"
        },
        "typography": {
          "textDecoration": "none"
        },
        ":hover": {
          "typography": {
            "textDecoration": "underline"
          }
        }
      },
      "button": {
        "color": {
          "background": "var(--wp--preset--color--primary)",
          "text": "var(--wp--preset--color--white)"
        },
        "border": {
          "radius": "12px"
        },
        "spacing": {
          "padding": {
            "top": "0.9rem",
            "bottom": "0.9rem",
            "left": "1.6rem",
            "right": "1.6rem"
          }
        },
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--heading)",
          "fontWeight": "600",
          "fontSize": "var(--wp--preset--font-size--small)"
        },
        ":hover": {
          "color": {
            "background": "var(--wp--preset--color--primary-dark)"
          }
        }
      }
    },
    "spacing": {
      "blockGap": "1.5rem",
      "padding": {
        "top": "0",
        "right": "clamp(1rem, 5vw, 2rem)",
        "bottom": "0",
        "left": "clamp(1rem, 5vw, 2rem)"
      }
    }
  },
  "customTemplates": [
    {
      "name": "page-full-width",
      "title": "Full Width (no sidebar)",
      "postTypes": [
        "page"
      ]
    },
    {
      "name": "template-landing",
      "title": "Landing Page (industry)",
      "postTypes": [
        "page"
      ]
    }
  ],
  "templateParts": [
    {
      "name": "header",
      "title": "Header",
      "area": "header"
    },
    {
      "name": "footer",
      "title": "Footer",
      "area": "footer"
    }
  ]
}